# Nutrient DWS — https://dashboard.nutrient.io
# Views C and D. The Data Extraction product key covers both /extraction/parse modes.
NUTRIENT_EXTRACTION_KEY=
NUTRIENT_ACCESSIBILITY_KEY=
NUTRIENT_PROCESSOR_KEY=

# Foxit — https://account.foxit.com/site/sign-up
# One credential pair covers PDF Services, eSign, Document Generation and PDF Embed.
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=

# SerpApi — https://serpapi.com/users/sign_up
SERPAPI_KEY=

# OpenRouter — https://openrouter.ai/keys  (model layer for the benchmark)
OPENROUTER_API_KEY=
